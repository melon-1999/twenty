# Copy this file to `.env` and fill in the values, then run:
#   docker compose -f docker-compose.prod.yml up -d

# Image tag from GHCR. "latest" = newest build of the main branch.
# Pin to a short commit sha (e.g. sha-abc1234) for reproducible deploys.
TAG=latest

# Domain that points (A record) at this VPS. Caddy gets a TLS cert for it.
DOMAIN=crm.your-domain.com

# Public URL of the app. MUST be https and match DOMAIN exactly,
# otherwise sign-in, uploads and redirects break.
SERVER_URL=https://crm.your-domain.com

# App secret used to sign tokens. Generate once and keep stable:
#   openssl rand -base64 32
APP_SECRET=CHANGE_ME

# PostgreSQL credentials (the db service is created with these).
PG_DATABASE_USER=postgres
# Generate:  openssl rand -base64 24
PG_DATABASE_PASSWORD=CHANGE_ME_STRONG

# Redis connection (internal to the compose network; leave as-is).
REDIS_URL=redis://redis:6379

# File storage: "local" (Docker volume) or "s3".
STORAGE_TYPE=local
